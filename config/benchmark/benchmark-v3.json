{
  "schema": "elf.benchmark_manifest/v4",
  "answer_contract": "config/benchmark/scoring-contract-v3.json",
  "runner": {
    "capacity": 1,
    "fallback_capacity": 1,
    "compose_file": "docker/benchmark/compose.yml",
    "image": "elf-benchmark-unit:v4",
    "unit_timeout_seconds": 3600,
    "context_budget_chars": 12000,
    "seed": 260813
  },
  "providers": {
    "chat": {
      "model": "deepseek/deepseek-v4.1-flash",
      "reasoning_effort": "low"
    },
    "embedding": {
      "model": "qwen/qwen3-embedding-8b",
      "dimensions": 1536
    }
  },
  "metrics": [
    "expected_evidence_recall_at_5",
    "ndcg_at_5",
    "forbidden_or_stale_evidence_hit_rate",
    "source_or_citation_trace_rate",
    "programmatic_answer_correctness",
    "native_correction_and_update_success",
    "native_deletion_or_forgetting_success",
    "privacy_scope_violation_rate",
    "unsupported_answer_rate",
    "cold_ingest_duration",
    "warm_query_latency",
    "completed_and_typed_failure_counts",
    "provider_usage_when_returned"
  ],
  "failure_classes": {
    "completed": {
      "quality_denominator": true
    },
    "product_failed": {
      "quality_denominator": false
    },
    "adapter_failed": {
      "quality_denominator": false
    },
    "harness_failed": {
      "quality_denominator": false
    },
    "provider_failed": {
      "quality_denominator": false
    },
    "configuration_failed": {
      "quality_denominator": false
    },
    "timeout_failed": {
      "quality_denominator": false
    },
    "cleanup_failed": {
      "quality_denominator": false
    },
    "not_applicable": {
      "quality_denominator": false
    }
  },
