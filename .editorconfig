root = true

[*]
charset=utf-8
end_of_line=lf
indent_size=tab
indent_style=tab
insert_final_newline=true
max_line_length=100
tab_width=4
trim_trailing_whitespace=true

[*.{sh,yml,yaml}]
indent_size=2
indent_style=space

[*.{js,json,jsonc,jsx,mjs,mts,ts,tsx}]
indent_size=2
indent_style=space
tab_width=2

[*.py]
indent_size=4
indent_style=space
